{
  "name": "@nekkos/cli",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Nekkos CLI + MCP server, drive your local agent from the terminal or other tools (Claude Code, Codex, …).",
  "bin": {
    "nekkos": "./dist/index.js",
    "kotrain": "./dist/index.js"
  },
  "main": "./dist/run.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@nekkos/host": "*",
    "@nekkos/shared": "*"
  }
}
